# ---- ورود ادمین ----
# نام کاربری و رمز ورود به پنل مدیریت (/login). حتماً مقدار امن قرار دهید.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# ---- امنیت کوکی ----
# یک رشته تصادفی طولانی. برای تولید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# ---- آدرس سایت (برای سئو و sitemap) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- کوکی امن ----
# اگر کاربران از طریق HTTPS به سایت می‌رسند (حتی پشت CDN مثل آروان) این را true کنید.
# اگر سایت فقط روی HTTP باز می‌شود false بماند، وگرنه کوکی ورود ارسال نمی‌شود.
COOKIE_SECURE=true

# ---- دامنه‌های مجاز برای فرم‌ها (پشت CDN/پراکسی لازم است) ----
# دامنه‌ی سایت را بدون https:// وارد کنید. چند دامنه را با کاما جدا کنید.
ALLOWED_ORIGINS=your-domain.com,www.your-domain.com

NODE_ENV=production
