# ---- ورود ادمین ----
# نام کاربری و رمز ورود به پنل مدیریت (/login). حتماً مقدار امن قرار دهید.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# ---- امنیت کوکی ----
# یک رشته تصادفی طولانی. برای تولید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# ---- آدرس سایت (برای سئو و sitemap) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- کوکی امن ----
# فقط وقتی سایت روی HTTPS است این را true کنید. روی HTTP باید false بماند،
# وگرنه کوکی ورود ارسال نمی‌شود و مدام از پنل خارج می‌شوید.
COOKIE_SECURE=false

NODE_ENV=production
